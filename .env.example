# Copiare in .env (locale) oppure impostare nelle Environment Variables di Vercel.

# URL definitivo del sito, senza slash finale. Finché è vuoto il sito è marcato "noindex"
# e robots.txt blocca i motori di ricerca (utile per anteprime *.vercel.app).
PUBLIC_SITE_URL=

# Modulo contatti (servizio Resend, https://resend.com)
RESEND_API_KEY=
# Indirizzo che riceve i messaggi
CONTACT_TO_EMAIL=art.claudiadandrea@gmail.com
# Mittente: finché non verifichi un dominio su Resend usa onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
