---
interface Props {
  name: 'sculpture' | 'light' | 'event' | 'workshop' | 'menu' | 'close' | 'arrow' | 'prev' | 'next';
}
const { name } = Astro.props;
---

{
  name === 'sculpture' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="22" r="3.2" />
      <path d="M24 18.8c-3-5-1.5-10 0-12 1.5 2 3 7 0 12Z" />
      <path d="M26.9 20.4c5.700-.9 9.600 2.400 11 4.700-2.700.4-8.200-.4-11-4.700Z" />
      <path d="M25.800 24.700c3.800 4.400 3.300 9.500 1.800 11.600-2.200-1.400-5.900-5.700-1.800-11.600Z" />
      <path d="M22.200 24.700c-3.800 4.400-3.300 9.500-1.800 11.600 2.200-1.400 5.900-5.700 1.800-11.600Z" />
      <path d="M21.100 20.400c-5.700-.9-9.600 2.400-11 4.700 2.700.4 8.200-.4 11-4.700Z" />
      <path d="M24 28v14M24 36c-3-1-5-.5-6.500 1.200M24 38.500c2.500-1 4.300-.4 5.700 1" />
    </svg>
  )
}
{
  name === 'light' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="M13 31c0-9 4.500-17 11-17s11 8 11 17Z" />
      <path d="M10.500 31h27" />
      <path d="M24 14V8M17 11l-1.500-2M31 11l1.500-2" />
      <path d="M19 36h10M21.500 40h5" />
    </svg>
  )
}
{
  name === 'event' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="M24 8c1 7 3 9 10 10-7 1-9 3-10 10-1-7-3-9-10-10 7-1 9-3 10-10Z" />
      <path d="M36 28c.6 3.500 1.500 4.400 5 5-3.500.6-4.400 1.500-5 5-.6-3.500-1.500-4.400-5-5 3.500-.6 4.400-1.500 5-5Z" />
      <path d="M10 30c.5 2.600 1.200 3.300 3.800 3.800-2.600.5-3.300 1.200-3.800 3.800-.5-2.600-1.200-3.300-3.800-3.800 2.600-.5 3.300-1.200 3.800-3.800Z" />
    </svg>
  )
}
{
  name === 'workshop' && (
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="14" cy="34" r="4.500" />
      <circle cx="26" cy="38" r="4.500" />
      <path d="M17 30.500 36 9M29 34.500 14 12" />
      <path d="M33 22l7 8M38 14l3 3" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" aria-hidden="true">
      <path d="M3 8h18M3 12h18M3 16h18" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" aria-hidden="true">
      <path d="M5 5l14 14M19 5 5 19" />
    </svg>
  )
}
{
  name === 'arrow' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
      <path d="M4 12h16M14 6l6 6-6 6" />
    </svg>
  )
}
{
  name === 'prev' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 12H4M10 6l-6 6 6 6" />
    </svg>
  )
}
{
  name === 'next' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12h16M14 6l6 6-6 6" />
    </svg>
  )
}
