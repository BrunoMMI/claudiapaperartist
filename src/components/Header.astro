---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { nav, route, routes, alternate, ui, tr, type Lang } from '../i18n';
import markDark from '../assets/logo/logo-mark-dark.png';
import markLight from '../assets/logo/logo-mark-light.png';

interface Props {
  /** "light": testo chiaro, per pagine con testata scura (home) */
  tone?: 'light' | 'dark';
  lang?: Lang;
}
const { tone = 'dark', lang = 'it' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
const home = routes.home[lang];
const switcher = (['it', 'en'] as Lang[]).map((l) => ({ l, href: alternate(path, l), current: l === lang }));
---

<header class="site-header" data-tone={tone}>
  <div class="wrap site-header__bar">
    <a href={home} class="brand" aria-label={`${site.name} ${site.role} – home`}>
      <Image src={tone === 'light' ? markLight : markDark} alt="" width={112} loading="eager" />
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__role">{site.role}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label={tr(ui.mainNav, lang)}>
      {nav.map((n) => <a href={route(n.key, lang)} aria-current={isCurrent(route(n.key, lang)) ? 'page' : undefined}>{tr(n.label, lang)}</a>)}
    </nav>

    <div class="lang-switch" role="group" aria-label={tr(ui.language, lang)}>
      {
        switcher.map(({ l, href, current }) => (
          <a href={href} hreflang={l} lang={l} aria-current={current ? 'true' : undefined} aria-label={current ? undefined : tr(ui.switchTo, lang)}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>

    <a href="#menu" class="menu-btn" data-menu-open aria-label={tr(ui.openMenu, lang)} aria-controls="menu" aria-expanded="false">
      <Icon name="menu" />
    </a>
  </div>
</header>

<div id="menu" class="menu-overlay" role="dialog" aria-modal="true" aria-label={tr(ui.menuLabel, lang)}>
  <div class="menu-panel">
    <div class="menu-panel__top">
      <span class="label">{tr(ui.menuLabel, lang)}</span>
      <a href="#contenuto" class="menu-btn menu-btn--small" data-menu-close aria-label={tr(ui.closeMenu, lang)}>
        <Icon name="close" />
      </a>
    </div>
    <nav aria-label={tr(ui.fullNav, lang)}>
      <ul>
        <li style="--i:0"><a href={home} aria-current={path === home ? 'page' : undefined}>{tr(ui.home, lang)}</a></li>
        {nav.map((n, i) => <li style={`--i:${i + 1}`}><a href={route(n.key, lang)} aria-current={isCurrent(route(n.key, lang)) ? 'page' : undefined}>{tr(n.label, lang)}</a></li>)}
      </ul>
    </nav>
    <div class="menu-panel__foot">
      <div class="lang-switch lang-switch--panel" role="group" aria-label={tr(ui.language, lang)}>
        {
          switcher.map(({ l, href, current }) => (
            <a href={href} hreflang={l} lang={l} aria-current={current ? 'true' : undefined}>{l.toUpperCase()}</a>
          ))
        }
      </div>
      <a href={`mailto:${site.email}`} class="inline-link">{site.email}</a>
      {site.socials.map((s) => <a href={s.href} class="inline-link" rel="me noopener" target="_blank">{s.label}</a>)}
    </div>
  </div>
</div>
