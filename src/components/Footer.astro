---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, phoneDigits, whatsappHref } from '../config/site';
import { route, ui, tr, type Lang } from '../i18n';
import logoDark from '../assets/logo/logo-full-dark.png';

interface Props {
  lang?: Lang;
}
const { lang = 'it' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href={route('home', lang)} aria-label={`${site.name} ${site.role} – home`}>
          <Image src={logoDark} alt={`${site.name}, ${site.role}`} width={220} loading="lazy" style="width:13.5rem;height:auto" />
        </a>
        <p class="muted" style="margin-top:1.4rem;max-width:16rem;font-size:0.92rem">
          {tr(site.tagline, lang)}<br />{tr(ui.footerLine, lang)}
        </p>
      </div>
      <div>
        <h2>{tr(ui.footerInfo, lang)}</h2>
        <ul>
          <li><a href={`mailto:${site.email}`} class="inline-link">{site.email}</a></li>
          {site.phone && <li><a href={whatsappHref ?? `tel:${phoneDigits}`} class="inline-link" rel="noopener" target="_blank">{site.phone} · WhatsApp</a></li>}
          {site.address && <li>{site.address}</li>}
        </ul>
      </div>
      <div>
        <h2>{tr(ui.footerFollow, lang)}</h2>
        <ul>
          {site.socials.map((s) => <li><a href={s.href} class="inline-link" rel="me noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{tr(ui.footerWrite, lang)}</h2>
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem">
          <p style="max-width:14rem;font-size:0.92rem">{tr(ui.footerPitch, lang)}</p>
          <a href={route('contact', lang)} class="round-btn" aria-label={tr(ui.goContact, lang)}><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} {site.name}</span>
      <span><a href={route('privacy', lang)} class="inline-link">{tr(ui.privacy, lang)}</a></span>
    </div>
  </div>
</footer>
