---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { photo } from '../data/photos';
import { site } from '../config/site';
import { route, tr, type L, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (v: L) => tr(v, lang);

const personExtra = {
  '@type': 'AboutPage',
  name: `About me · ${site.name}`,
  inLanguage: lang === 'it' ? 'it-IT' : 'en-GB',
  about: { '@type': 'Person', name: site.name, jobTitle: site.role },
};

const copy = {
  description: {
    it: "Claudia D'Andrea è un'artista autodidatta: la sua ricerca si fonda sullo studio della luce, attraverso sculture, paper lamps, installazioni luminose e allestimenti in carta e cartapesta.",
    en: "Claudia D'Andrea is a self-taught artist: her research is based on the study of light, through sculptures, paper lamps, light installations and set designs in paper and papier-mâché.",
  },
  kicker: { it: 'About me', en: 'About me' },
  lead: {
    it: 'Donna, mamma, moglie… artista autodidatta appassionata di arte, musica, lettura, viaggi e cucina.',
    en: 'Woman, mother, wife… self-taught artist, passionate about art, music, reading, travel and cooking.',
  },
  photoAlt: {
    it: 'Claudia D’Andrea al lavoro con il pennello in mano, ripresa attraverso il foro di una scultura di carta',
    en: 'Claudia D’Andrea at work with a brush in her hand, seen through the opening of a paper sculpture',
  },
  me: {
    it: [
      'La mia ricerca artistica si fonda sullo studio della luce: una luce delicata e sottile. Le mie opere nascono dall’impiego della carta e della cartapesta, materiali che diventano strumenti d’espressione e di trasformazione della materia. Il mio lavoro unisce manualità, immaginazione, ricerca e creatività, con l’obiettivo di trasformare un supporto semplice e versatile in opere e installazioni capaci di dialogare con gli spazi e di suscitare emozioni.',
      'La mia attività si articola nella realizzazione di sculture, paper lamps, installazioni luminose e allestimenti scenografici, pensati per valorizzare gli ambienti e conferire loro una nuova dimensione estetica ed emozionale. Attraverso lo studio e la sperimentazione delle potenzialità espressive della carta, do vita a creazioni che coniugano ricerca artistica, sensibilità progettuale e cura del dettaglio.',
      'Il mio percorso si è arricchito nel tempo attraverso la partecipazione a mostre ed esposizioni in Italia e all’estero, preziose occasioni di confronto e crescita che hanno consolidato la mia identità artistica.',
      'Accanto alla produzione scultorea, promuovo e conduco laboratori dedicati alla lavorazione della carta e della cartapesta, offrendo ai partecipanti l’opportunità di avvicinarsi a queste tecniche, esplorarne le possibilità creative e sperimentare il valore vivo della materia.',
    ],
    en: [
      'My artistic research is based on the study of light: a delicate, subtle light. My works are born from the use of paper and papier-mâché, materials that become tools of expression and of transformation of matter. My work combines craftsmanship, imagination, research and creativity, with the aim of turning a simple, versatile support into works and installations able to dialogue with spaces and stir emotions.',
      'My activity takes the form of sculptures, paper lamps, light installations and scenographic set designs, conceived to enhance spaces and give them a new aesthetic and emotional dimension. Through the study and experimentation of the expressive potential of paper, I bring to life creations that combine artistic research, design sensitivity and attention to detail.',
      'My journey has been enriched over time by taking part in exhibitions in Italy and abroad, precious opportunities for exchange and growth that have consolidated my artistic identity.',
      'Alongside my sculptural production, I promote and lead workshops on working with paper and papier-mâché, giving participants the chance to approach these techniques, explore their creative possibilities and experience the living value of the material.',
    ],
  },
  closing: { it: 'Opere, mostre, laboratori e progetti su misura.', en: 'Works, exhibitions, workshops and bespoke projects.' },
  contact: { it: 'Contattami', en: 'Get in touch' },
};
---

<Layout title="About me" lang={lang} description={t(copy.description)} image={photo('about/claudia')} jsonLd={[personExtra]}>
  <section class="page-hero">
    <div class="wrap split split--wide-text" style="align-items:center">
      <div>
        <p class="label muted" style="margin-bottom:1.6rem">{t(copy.kicker)}</p>
        <h1 class="display-xl" style="max-width:12ch">Claudia D'Andrea</h1>
        <p class="lede" style="margin-top:2rem;max-width:30ch">{t(copy.lead)}</p>
      </div>
      <div class="portrait-round" data-reveal="image">
        <Photo name="about/claudia" alt={t(copy.photoAlt)} sizes="(min-width: 860px) 24rem, 80vw" widths={[400, 700, 1000]} loading="eager" />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="prose" data-reveal>
        {tr(copy.me, lang).map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="display:grid;gap:1.8rem;justify-items:start">
      <p class="display-md" style="max-width:26ch">{t(copy.closing)}</p>
      <a href={route('contact', lang)} class="cta">{t(copy.contact)}</a>
    </div>
  </section>
</Layout>
