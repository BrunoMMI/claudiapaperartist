---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Carousel from '../components/Carousel.astro';
import { workshops, offers, christmas } from '../data/workshops';
import { photo } from '../data/photos';
import { route, tr, type L, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (v: L) => tr(v, lang);

const copy = {
  title: { it: 'Laboratori creativi', en: 'Creative workshops' },
  seo: { it: 'Laboratori di carta e cartapesta', en: 'Paper and papier-mâché workshops' },
  description: {
    it: "Workshop di carta e cartapesta per adulti e bambini: piegare, tagliare, modellare e illuminare la carta con Claudia D'Andrea, dal laboratorio di Natale ai cicli per ragazzi.",
    en: "Paper and papier-mâché workshops for adults and children: folding, cutting, shaping and lighting paper with Claudia D'Andrea, from the Christmas workshop to cycles for young people.",
  },
  lead: {
    it: 'Piccoli gruppi, gesti lenti: workshop per imparare a piegare, tagliare e illuminare la carta.',
    en: 'Small groups, slow gestures: workshops to learn how to fold, cut and light paper.',
  },
  offers: { it: 'Laboratori', en: 'Workshops' },
  info: { it: 'Richiedi informazioni', en: 'Ask for information' },
  christmas: { it: 'Laboratorio di Natale', en: 'Christmas workshop' },
  done: { it: 'Laboratori realizzati', en: 'Past workshops' },
};
const ld = [
  {
    '@type': 'ItemList',
    itemListElement: workshops.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Event',
        name: tr(w.title, lang),
        description: tr(w.text, lang).join(' '),
        startDate: tr(w.when, lang),
        location: { '@type': 'Place', name: tr(w.place, lang) },
        organizer: { '@type': 'Person', name: "Claudia D'Andrea" },
      },
    })),
  },
];
---

<Layout title={t(copy.seo)} lang={lang} description={t(copy.description)} image={photo('laboratori/officina-3')} jsonLd={ld}>
  <PageHero title={t(copy.title)} lead={t(copy.lead)} />

  <section class="section-tight" aria-labelledby="offerte-title">
    <div class="wrap">
      <h2 id="offerte-title" class="label" style="margin-bottom:1.6rem">{t(copy.offers)}</h2>
      <div class="offer-grid">
        {
          offers.map((o, i) => (
            <article class="offer" data-reveal style={`--d:${i * 90}ms`}>
              <h3 class="display-md">{t(o.title)}</h3>
              <p class="muted">{t(o.text)}</p>
              <p class="label">{t(o.meta)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="christmas-lights" class="section-tight" aria-labelledby="christmas-title">
    <div class="wrap">
      <hr class="rule" style="margin-bottom:2.2rem" />
      <div class="cat-head">
        <div data-reveal>
          <p class="label muted" style="margin-bottom:1rem">{t(copy.christmas)}</p>
          <h2 id="christmas-title" class="display-lg">{christmas.title}</h2>
        </div>
        <div class="prose" data-reveal style="--d:100ms">
          <p>{t(christmas.text)}</p>
          <p class="label" style="margin-top:1.2rem">{t(christmas.meta)}</p>
          <p style="margin-top:1.8rem"><a href={route('contact', lang)} class="cta">{t(copy.info)}</a></p>
        </div>
      </div>
      <Carousel shots={christmas.shots} group="lab-christmas" lang={lang} label={christmas.title} />
    </div>
  </section>

  <section class="section" aria-labelledby="realizzati-title">
    <div class="wrap">
      <h2 id="realizzati-title" class="display-lg">{t(copy.done)}</h2>
    </div>
    {
      workshops.map((w) => (
        <article class="wrap" id={w.slug} aria-labelledby={`w-${w.slug}`} style="margin-top:clamp(3rem,6vw,5rem)">
          <hr class="rule" style="margin-bottom:2.2rem" />
          <div class="cat-head">
            <div data-reveal>
              <h3 id={`w-${w.slug}`} class="display-md">{t(w.title)}</h3>
              <p class="label muted" style="margin-top:1rem">{t(w.when)}</p>
              <p class="muted" style="font-size:0.92rem;margin-top:0.3rem">{t(w.place)}</p>
            </div>
            <div class="prose" data-reveal style="--d:100ms">
              {tr(w.text, lang).map((p) => <p>{p}</p>)}
            </div>
          </div>
          <Carousel shots={w.shots} poster={w.poster} group={`lab-${w.slug}`} lang={lang} label={t(w.title)} />
        </article>
      ))
    }
  </section>
</Layout>
